{
  "name": "budget-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json && pnpm --filter @budget/mobile exec tsc --noEmit && pnpm --filter @budget/web exec tsc --noEmit",
    "test": "vitest run",
    "test:web": "pnpm --filter @budget/web test",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:web"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "react-native-libsodium"
    ],
    "overrides": {
      "react-native-worklets": "0.10.4"
    },
    "patchedDependencies": {
      "react-native-libsodium@1.7.0": "patches/react-native-libsodium@1.7.0.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
